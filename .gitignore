.venv/
.tools/
__pycache__/
*.pyc
.env
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.corrupt*
.stage1_result.json
clients/termit-desktop/build/icon.iconset/

# Client builds
clients/*/node_modules/
clients/*/dist/
clients/termit-desktop/dist-electron/
clients/termit-desktop/release/
clients/termit-desktop/out/
clients/termit-shell/.build/
clients/termit-shell/build/
clients/termit-shell/release/

# Cursor hook runtime (tracked: hooks.json + token_watch.py)
.cursor/hooks/state/*
!.cursor/hooks/state/.gitkeep
.cursor/hooks/token_watch.env
.cursor/hooks/session_checkpoint.env
.cursor/memory/checkpoints/*.md
!.cursor/memory/checkpoints/.gitkeep

# Runtime artifacts under data/ (keep seed JSON tracked)
data/*
!data/eval_scenarios.json
!data/agent_templates.json
!data/skills/
!data/skills/**/SKILL.md
!data/repo_model_profiles.json
!data/routing_benchmarks.json
!data/finetune/
data/finetune/*
!data/finetune/.gitkeep
!data/eval_fixtures/
data/eval_fixtures/*
!data/eval_fixtures/patch_sample.txt
!data/desktop_north_star.json
!data/desktop_policy_presets.json
