# Shared settings for external Stage1 schedulers (launchd / cron / GitHub Actions).
TERMIT_BASE_URL=http://127.0.0.1:8765
TERMIT_API_KEY=

TERMIT_STAGE1_NAME=weekly-stage1
TERMIT_STAGE1_BASE_MODEL=
TERMIT_TEACHER_MODEL=ollama:deepseek-coder
TERMIT_STAGE1_MIN_SAMPLES=10
TERMIT_STAGE1_RUN_EVAL_BASELINE=true
TERMIT_STAGE1_EVAL_LIMIT=24
TERMIT_STAGE1_AUTO_REGISTER_ADAPTER=false
TERMIT_STAGE1_REQUIRE_HEALTH=true
TERMIT_STAGE1_HTTP_TIMEOUT=30

# Post-train (scripts/post_stage1_train.py, stage1_full_loop.sh)
TERMIT_FINETUNE_AUTO_TRAIN=false
TERMIT_FINETUNE_TRAINER=ollama
TERMIT_FINETUNE_OUTPUT_MODEL=termit-core-ft
TERMIT_FINETUNE_AUTO_REGISTER_AFTER_TRAIN=false
TERMIT_FINETUNE_REPO_PROFILE_ID=termit-core
TERMIT_STAGE1_RUN_POST_EVAL=true

# Optional: full training loop with eval regression gate (scripts/training_loop_full.sh)
TERMIT_WEEKLY_TRAINING_LOOP=false
TERMIT_EVAL_AUTO_PROMOTE_BASELINE=true
TERMIT_EVAL_MIN_IMPROVEMENT_FOR_PROMOTE=0.05
TERMIT_FINETUNE_MIN_EVAL_IMPROVEMENT=0.05
TERMIT_FINETUNE_KPI_STRICT=false
TERMIT_EVAL_CATEGORY=cursor_parity
TERMIT_EVAL_LIMIT=20
TERMIT_EVAL_MAX_PASS_RATE_DROP=0.05
