# Termit reverse proxy (TLS via Caddy automatic HTTPS when DOMAIN is set).
# For local HTTP-only testing, use :8080 block below.

{
	email {$ACME_EMAIL:internal@localhost}
}

:8080 {
	encode gzip zstd
	reverse_proxy termit:8765
}

# Production HTTPS (set DOMAIN env, e.g. termit.example.com).
# Keep a non-empty default so Caddy doesn't parse an empty site label.
{$DOMAIN:localhost} {
	encode gzip zstd
	reverse_proxy termit:8765
}
