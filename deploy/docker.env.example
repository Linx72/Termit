# Hosted/docker profile — copy to .env for production-like deploy
TERMIT_AUTH_ENABLED=true
TERMIT_API_KEYS=admin-key:5000:admin:core,operator-key:2000:operator:core,viewer-key:500:viewer:core
TERMIT_ALLOWED_ORIGINS=https://your-domain.example
TERMIT_LOG_JSON=true
TERMIT_LOG_LEVEL=INFO

TERMIT_FINETUNE_AUTO_CAPTURE_SIGNALS=true
TERMIT_FINETUNE_REGRESSION_GATE_ENABLED=true
TERMIT_FINETUNE_AUTO_POST_EVAL=true
TERMIT_FINETUNE_SHADOW_TRAFFIC_PERCENT=10

# Optional Slack/Discord incoming webhook for ops alerts
TERMIT_ALERT_WEBHOOK_URL=
