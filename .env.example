TERMIT_HOST=0.0.0.0
TERMIT_PORT=8765
TERMIT_ALLOWED_ORIGINS=*

# Default model routing strategy
TERMIT_DEFAULT_MODEL=ollama:deepseek-coder
TERMIT_CODE_MODEL=ollama:deepseek-coder
TERMIT_ANALYSIS_MODEL=ollama:qwen2.5-coder
TERMIT_DEFAULT_FALLBACK_MODEL=openai_compat:Qwen/Qwen2.5-Coder-32B-Instruct
TERMIT_CODE_FALLBACK_MODEL=openai_compat:deepseek-ai/deepseek-coder-33b-instruct
TERMIT_ANALYSIS_FALLBACK_MODEL=openai_compat:Qwen/Qwen2.5-Coder-32B-Instruct

# Provider base URLs
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=http://localhost:8001
OPENAI_COMPAT_API_KEY=

# Memory backend
TERMIT_MEMORY_BACKEND=sqlite
TERMIT_MEMORY_SQLITE_PATH=./termit_memory.db
TERMIT_MEMORY_MAX_MESSAGES=40

# Task history backend
TERMIT_TASK_BACKEND=sqlite
TERMIT_TASK_SQLITE_PATH=./termit_tasks.db
TERMIT_AGENT_RUN_BACKEND=sqlite
TERMIT_AGENT_RUN_SQLITE_PATH=./termit_agent_runs.db
TERMIT_AGENT_REGISTRY_FILE=./data/agents.json
TERMIT_AGENT_MAX_CONCURRENCY=2
TERMIT_AGENT_MAX_QUEUE_SIZE=100
TERMIT_AGENT_RUN_MAX_ATTEMPTS=2
TERMIT_AGENT_RUN_RETRY_BACKOFF_MS=250
TERMIT_AGENT_RUN_MAX_EVENTS_PER_RUN=500
TERMIT_AGENT_RUN_MAX_RESPONSE_CHARS=12000
TERMIT_AGENT_RUN_RETENTION_DAYS=14
TERMIT_AGENT_MAINTENANCE_ENABLED=true
TERMIT_AGENT_CLEANUP_INTERVAL_SECONDS=3600
TERMIT_AGENT_METRICS_SNAPSHOT_INTERVAL_SECONDS=900
TERMIT_AGENT_VERIFY_AFTER_PATCH=false
TERMIT_AGENT_VERIFY_CMD=python3 -m unittest discover -s tests -q

# Dual-pass: draft model then review validator (coding/review/debug)
TERMIT_DUAL_PASS_ENABLED=false
TERMIT_DUAL_PASS_TASK_TYPES=coding,review,debug

# Tasks auto mode delegates to agent run instead of scripted steps
TERMIT_TASK_USE_AGENT=false
TERMIT_TASK_AGENT_ID=

# Fast tab completion (FIM) max tokens
TERMIT_FIM_MAX_TOKENS=64

# Response cache (non-memory chat requests)
TERMIT_RESPONSE_CACHE_BACKEND=memory
TERMIT_RESPONSE_CACHE_SQLITE_PATH=./termit_response_cache.db
TERMIT_RESPONSE_CACHE_TTL_SECONDS=120

# Code retrieval + context compaction
TERMIT_RETRIEVAL_ENABLED=true
# keyword | semantic | hybrid (semantic + keyword fallback)
TERMIT_RETRIEVAL_MODE=hybrid
TERMIT_RETRIEVAL_ROOT_PATH=.
TERMIT_RETRIEVAL_EMBED_MODEL=nomic-embed-text
TERMIT_RETRIEVAL_EMBED_CACHE_PATH=./data/retrieval_embeddings.db
TERMIT_RETRIEVAL_MAX_CHUNKS=6
TERMIT_RETRIEVAL_CHUNK_MAX_CHARS=1200
TERMIT_RETRIEVAL_MAX_FILE_BYTES=200000
TERMIT_CONTEXT_MAX_MESSAGES=20
TERMIT_CONTEXT_MAX_CHARS=12000
TERMIT_CONTEXT_SUMMARY_MAX_CHARS=2000

# API auth and daily quotas (optional)
TERMIT_AUTH_ENABLED=false
TERMIT_API_KEYS=dev-key:1000:admin:core,viewer-key:300:viewer:beta
TERMIT_TEAM_QUOTAS=core:5000,beta:2000
TERMIT_REPO_MODEL_PROFILES_PATH=./data/repo_model_profiles.json
TERMIT_ROUTING_BENCHMARKS_PATH=./data/routing_benchmarks.json

# Fine-tune pipeline artifacts
TERMIT_FINETUNE_DATASETS_DIR=./data/finetune/datasets
TERMIT_FINETUNE_JOBS_PATH=./data/finetune/jobs.json
TERMIT_FINETUNE_ADAPTERS_PATH=./data/finetune/adapters.json
TERMIT_FINETUNE_PIPELINES_PATH=./data/finetune/pipelines.json
TERMIT_FINETUNE_PIPELINE_MAX_CONCURRENCY=1

# Stage1 weekly scheduler (built-in, runs inside Termit process)
TERMIT_STAGE1_SCHEDULE_ENABLED=false
TERMIT_STAGE1_SCHEDULE_WEEKDAY=0
TERMIT_STAGE1_SCHEDULE_HOUR=3
TERMIT_STAGE1_SCHEDULE_MINUTE=0
TERMIT_STAGE1_SCHEDULE_NAME=weekly-stage1
TERMIT_STAGE1_SCHEDULE_BASE_MODEL=
TERMIT_STAGE1_SCHEDULE_MIN_SAMPLES=10
TERMIT_STAGE1_SCHEDULE_RUN_EVAL_BASELINE=true
TERMIT_STAGE1_SCHEDULE_EVAL_LIMIT=24
TERMIT_STAGE1_SCHEDULE_AUTO_REGISTER_ADAPTER=false
TERMIT_STAGE1_SCHEDULE_STATE_PATH=./data/finetune/schedule_state.json

# Built-in trainer (Ollama Modelfile create) after Stage1 pipeline
TERMIT_FINETUNE_AUTO_TRAIN=false
TERMIT_FINETUNE_TRAINER=ollama
TERMIT_FINETUNE_OLLAMA_BIN=ollama
TERMIT_FINETUNE_OUTPUT_MODEL=termit-core-ft
TERMIT_FINETUNE_AUTO_REGISTER_AFTER_TRAIN=false
TERMIT_FINETUNE_MODELFILES_DIR=./data/finetune/modelfiles
TERMIT_FINETUNE_TRAIN_TIMEOUT_SECONDS=600
TERMIT_FINETUNE_REPO_PROFILE_ID=termit-core

# Auto training-data capture (append-only, never deletes SQLite/feedback sources)
TERMIT_FINETUNE_AUTO_CAPTURE_SIGNALS=true
TERMIT_FINETUNE_TRAINING_SIGNALS_PATH=./data/finetune/training_signals.jsonl
TERMIT_FINETUNE_MIN_SIGNAL_OUTPUT_CHARS=32
TERMIT_FINETUNE_AUTO_POST_EVAL=true

# Regression gate: block promote or use shadow routing on pass_rate drop
TERMIT_FINETUNE_REGRESSION_GATE_ENABLED=true
TERMIT_FINETUNE_MAX_TRAIN_REGRESSION=0.02
TERMIT_FINETUNE_SHADOW_TRAFFIC_PERCENT=10

# Optional Slack/Discord webhook for ops alerts (POST /api/ops/alerts/dispatch)
TERMIT_ALERT_WEBHOOK_URL=

# External scheduler CLI (launchd / cron / GitHub Actions)
TERMIT_BASE_URL=http://127.0.0.1:8765
TERMIT_API_KEY=

# Docker Compose / Caddy (optional)
TERMIT_PUBLIC_DOMAIN=
TERMIT_ACME_EMAIL=ops@example.com
TERMIT_DEFAULT_DAILY_QUOTA=1000
TERMIT_DEFAULT_API_ROLE=operator
TERMIT_QUOTA_SQLITE_PATH=./termit_quota.db
TERMIT_FEEDBACK_FILE=./data/feedback.jsonl
TERMIT_CIRCUIT_FAILURE_THRESHOLD=3
TERMIT_CIRCUIT_COOLDOWN_SECONDS=60
TERMIT_DEGRADE_EMPTY_RATE=0.05
TERMIT_DEGRADE_FALLBACK_RATE=0.35
TERMIT_AGENT_ALERT_QUEUE_UTILIZATION_PERCENT=80
TERMIT_AGENT_ALERT_DEAD_LETTER_RATE=0.15
TERMIT_AGENT_ALERT_MIN_WORKER_ALIVE_RATIO=1.0
TERMIT_EVAL_SCENARIOS_PATH=./data/eval_scenarios.json
TERMIT_EVAL_REPORT_FILE=./data/eval_reports.jsonl

# Response cache and telemetry
TERMIT_RESPONSE_CACHE_BACKEND=memory
TERMIT_RESPONSE_CACHE_SQLITE_PATH=./termit_response_cache.db
TERMIT_RESPONSE_CACHE_TTL_SECONDS=120
TERMIT_TELEMETRY_MAX_LATENCY_POINTS=5000
TERMIT_METRICS_SNAPSHOT_FILE=./data/metrics_snapshots.jsonl
