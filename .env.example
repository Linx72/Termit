TERMIT_HOST=0.0.0.0
TERMIT_PORT=8765
TERMIT_ALLOWED_ORIGINS=*

# Runtime models (inference / agents / chat) — finetuned Termit weights
TERMIT_DEFAULT_MODEL=ollama:termit-core-ft
TERMIT_CODE_MODEL=ollama:termit-core-ft
TERMIT_ANALYSIS_MODEL=ollama:termit-core-ft
TERMIT_DEFAULT_FALLBACK_MODEL=ollama:qwen2.5-coder
TERMIT_CODE_FALLBACK_MODEL=ollama:qwen2.5-coder
TERMIT_ANALYSIS_FALLBACK_MODEL=openai_compat:Qwen/Qwen2.5-Coder-32B-Instruct

# Teacher models (stage-1 finetune only — not used in chat routing)
TERMIT_TEACHER_MODEL=ollama:deepseek-coder
TERMIT_TEACHER_FALLBACK_MODEL=openai_compat:deepseek-ai/deepseek-coder-33b-instruct
TERMIT_CLOUD_TEACHER_MODEL=openai_compat:deepseek-ai/DeepSeek-V3
TERMIT_STAGE1_SCHEDULE_BASE_MODEL=

# Provider base URLs
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=http://localhost:8001
OPENAI_COMPAT_API_KEY=

# Memory backend
TERMIT_MEMORY_BACKEND=sqlite
TERMIT_MEMORY_SQLITE_PATH=./termit_memory.db
TERMIT_MEMORY_MAX_MESSAGES=40

# Task history backend
TERMIT_TASK_BACKEND=sqlite
TERMIT_TASK_SQLITE_PATH=./termit_tasks.db
TERMIT_AGENT_RUN_BACKEND=sqlite
TERMIT_AGENT_RUN_SQLITE_PATH=./termit_agent_runs.db
TERMIT_AGENT_REGISTRY_FILE=./data/agents.json
TERMIT_AGENT_MAX_CONCURRENCY=2
TERMIT_AGENT_MAX_QUEUE_SIZE=100
TERMIT_AGENT_RUN_MAX_ATTEMPTS=2
TERMIT_AGENT_SHUTDOWN_GRACE_SECONDS=30
TERMIT_AGENT_RUN_RETRY_BACKOFF_MS=250
TERMIT_AGENT_RUN_MAX_EVENTS_PER_RUN=500
TERMIT_AGENT_RUN_MAX_RESPONSE_CHARS=12000
TERMIT_AGENT_RUN_RETENTION_DAYS=14
TERMIT_AGENT_MAINTENANCE_ENABLED=true
TERMIT_AGENT_CLEANUP_INTERVAL_SECONDS=3600
TERMIT_AGENT_METRICS_SNAPSHOT_INTERVAL_SECONDS=900
TERMIT_AGENT_VERIFY_AFTER_PATCH=true
TERMIT_AGENT_VERIFY_CMD=python3 -m unittest discover -s tests -q

# Dual-pass: draft model then review validator (coding/review/debug)
TERMIT_DUAL_PASS_ENABLED=false
TERMIT_DUAL_PASS_TASK_TYPES=coding,review,debug

# Tasks auto mode delegates to agent run instead of scripted steps
TERMIT_TASK_USE_AGENT=true
TERMIT_TASK_AGENT_ID=

# Fast tab completion (FIM) max tokens
TERMIT_FIM_MAX_TOKENS=64

# Response cache (non-memory chat requests)
TERMIT_RESPONSE_CACHE_BACKEND=memory
TERMIT_RESPONSE_CACHE_SQLITE_PATH=./termit_response_cache.db
TERMIT_RESPONSE_CACHE_TTL_SECONDS=120

# Code retrieval + context compaction
TERMIT_RETRIEVAL_ENABLED=true
# keyword | semantic | hybrid (semantic + keyword fallback)
TERMIT_RETRIEVAL_MODE=semantic
TERMIT_RETRIEVAL_AUTO_REINDEX=true
TERMIT_RETRIEVAL_ROOT_PATH=.
TERMIT_RETRIEVAL_EMBED_MODEL=nomic-embed-text
TERMIT_RETRIEVAL_EMBED_CACHE_PATH=./data/retrieval_embeddings.db
TERMIT_RETRIEVAL_MAX_CHUNKS=6
TERMIT_RETRIEVAL_CHUNK_MAX_CHARS=1200
TERMIT_RETRIEVAL_MAX_FILE_BYTES=200000
TERMIT_CONTEXT_MAX_MESSAGES=20
TERMIT_CONTEXT_MAX_CHARS=12000
TERMIT_CONTEXT_SUMMARY_MAX_CHARS=2000
TERMIT_CONTEXT_ENRICHMENT_ENABLED=true
TERMIT_PROJECT_RULES_DIR=./data/projects

# API auth and daily quotas (optional)
TERMIT_AUTH_ENABLED=false
TERMIT_API_KEYS=dev-key:1000:admin:core,viewer-key:300:viewer:beta
TERMIT_TEAM_QUOTAS=core:5000,beta:2000
TERMIT_REPO_MODEL_PROFILES_PATH=./data/repo_model_profiles.json
TERMIT_ROUTING_BENCHMARKS_PATH=./data/routing_benchmarks.json

# Fine-tune pipeline artifacts
TERMIT_FINETUNE_DATASETS_DIR=./data/finetune/datasets
TERMIT_FINETUNE_JOBS_PATH=./data/finetune/jobs.json
TERMIT_FINETUNE_ADAPTERS_PATH=./data/finetune/adapters.json
TERMIT_FINETUNE_PIPELINES_PATH=./data/finetune/pipelines.json
TERMIT_FINETUNE_CYCLE_EVENTS_PATH=./data/finetune/stage1_cycle_events.jsonl
TERMIT_FINETUNE_PIPELINE_MAX_CONCURRENCY=1
TERMIT_FINETUNE_PIPELINE_STUCK_TIMEOUT_SECONDS=3600

# Stage1 weekly scheduler (built-in, runs inside Termit process)
TERMIT_STAGE1_SCHEDULE_ENABLED=false
TERMIT_STAGE1_SCHEDULE_WEEKDAY=0
TERMIT_STAGE1_SCHEDULE_HOUR=3
TERMIT_STAGE1_SCHEDULE_MINUTE=0
TERMIT_STAGE1_SCHEDULE_NAME=weekly-stage1
TERMIT_STAGE1_SCHEDULE_BASE_MODEL=
TERMIT_STAGE1_SCHEDULE_MIN_SAMPLES=10
TERMIT_STAGE1_SCHEDULE_RUN_EVAL_BASELINE=true
TERMIT_STAGE1_SCHEDULE_EVAL_LIMIT=24
TERMIT_STAGE1_SCHEDULE_AUTO_REGISTER_ADAPTER=false
TERMIT_STAGE1_SCHEDULE_STATE_PATH=./data/finetune/schedule_state.json

# Built-in trainer mode: ollama | modelfile | hf | hf_dpo
TERMIT_FINETUNE_AUTO_TRAIN=false
TERMIT_FINETUNE_TRAINER=ollama
TERMIT_FINETUNE_OLLAMA_BIN=ollama
TERMIT_FINETUNE_OUTPUT_MODEL=termit-core-ft
TERMIT_FINETUNE_AUTO_REGISTER_AFTER_TRAIN=false
TERMIT_FINETUNE_MODELFILES_DIR=./data/finetune/modelfiles
TERMIT_FINETUNE_ADAPTERS_DIR=./data/finetune/adapters
TERMIT_FINETUNE_TRAIN_TIMEOUT_SECONDS=600
# HF/Unsloth QLoRA (trainer_mode=hf). Requires NVIDIA GPU + `pip install unsloth` when DRY_RUN=false.
TERMIT_FINETUNE_HF_DRY_RUN=true
TERMIT_FINETUNE_HF_EPOCHS=1
TERMIT_FINETUNE_HF_LORA_RANK=16
TERMIT_FINETUNE_HF_MAX_SAMPLES=500
TERMIT_FINETUNE_HF_AUTO_GGUF=true
TERMIT_FINETUNE_HF_AUTO_OLLAMA=false
TERMIT_FINETUNE_LLAMA_CPP_PATH=
TERMIT_FINETUNE_PATCH_OUTCOMES_PATH=./data/finetune/patch_outcomes.jsonl
TERMIT_FINETUNE_CAPTURE_PATCH_REVERTS=true
TERMIT_FINETUNE_REPO_PROFILE_ID=termit-core

# Auto training-data capture (append-only, never deletes SQLite/feedback sources)
TERMIT_FINETUNE_AUTO_CAPTURE_SIGNALS=true
TERMIT_FINETUNE_TRAINING_SIGNALS_PATH=./data/finetune/training_signals.jsonl
TERMIT_FINETUNE_MIN_SIGNAL_OUTPUT_CHARS=32
TERMIT_FINETUNE_AUTO_POST_EVAL=true
# Backfill short task instructions before DPO export (scripts/normalize_training_signals.py)
TERMIT_NORMALIZE_SIGNALS_BEFORE_DPO=true

# Regression gate: block promote or use shadow routing on pass_rate drop
TERMIT_FINETUNE_REGRESSION_GATE_ENABLED=true
TERMIT_FINETUNE_MAX_TRAIN_REGRESSION=0.05
TERMIT_FINETUNE_MIN_EVAL_IMPROVEMENT=0.05
TERMIT_FINETUNE_KPI_STRICT=false
TERMIT_EVAL_KPI_BASELINE=./data/eval_kpi_baseline.json
TERMIT_EVAL_KPI_LAST=./data/eval_kpi_last.json
TERMIT_EVAL_PRE_TRAIN_MODEL=ollama:deepseek-coder
TERMIT_EVAL_MODEL_KPI_IDS=MB1,MB2,MB3
TERMIT_CAPTURE_KPI_BASELINE=true
TERMIT_FINETUNE_SHADOW_TRAFFIC_PERCENT=10
TERMIT_AUTO_START_OLLAMA=true
TERMIT_OLLAMA_WARM_ON_STARTUP=true
TERMIT_OLLAMA_WARM_MAX_MODELS=3
TERMIT_CHAT_LATENCY_RECENT_WINDOW=50

# Optional Slack/Discord webhook for ops alerts (POST /api/ops/alerts/dispatch)
TERMIT_ALERT_WEBHOOK_URL=

# External scheduler CLI (launchd / cron / GitHub Actions)
TERMIT_BASE_URL=http://127.0.0.1:8765
TERMIT_API_KEY=

# Docker Compose / Caddy (optional)
TERMIT_PUBLIC_DOMAIN=
TERMIT_ACME_EMAIL=ops@example.com
TERMIT_DEFAULT_DAILY_QUOTA=1000
TERMIT_DEFAULT_API_ROLE=operator
TERMIT_QUOTA_SQLITE_PATH=./termit_quota.db
TERMIT_FEEDBACK_FILE=./data/feedback.jsonl
TERMIT_CIRCUIT_FAILURE_THRESHOLD=3
TERMIT_CIRCUIT_COOLDOWN_SECONDS=60
TERMIT_DEGRADE_EMPTY_RATE=0.05
TERMIT_DEGRADE_FALLBACK_RATE=0.35
TERMIT_MAX_COST_PER_SUCCESSFUL_TASK_USD=1.0
TERMIT_AGENT_ALERT_QUEUE_UTILIZATION_PERCENT=80
TERMIT_AGENT_ALERT_DEAD_LETTER_RATE=0.15
TERMIT_AGENT_ALERT_MIN_WORKER_ALIVE_RATIO=1.0
TERMIT_EVAL_SCENARIOS_PATH=./data/eval_scenarios.json
TERMIT_EVAL_IQ_SCENARIOS_PATH=./data/eval_scenarios_iq.json
TERMIT_EVAL_SWE_SCENARIOS_PATH=./data/eval_scenarios_swe.json
TERMIT_EVAL_REPORT_FILE=./data/eval_reports.jsonl
TERMIT_ORCH_EVAL_REPORT_FILE=./data/orchestration_eval_reports.jsonl
TERMIT_EVAL_MIN_PASS_RATE=0.95
# Optional strict tier mode for scripts/eval_ci_gate.py: fast|deep|release
TERMIT_EVAL_GATE_TIER=
TERMIT_EVAL_CI_LIMIT=53
TERMIT_EVAL_QUALITY_JUDGE_MODEL=
# Model-bound eval gate tiers: model_bound_ci (tool fixtures) | model_bound_release (full slice + cloud judge)
TERMIT_MODEL_BOUND_GATE_TIER=model_bound_ci

# Capability review gate (scripts/eval_capability_gate.py)
# Tier presets: ci|nightly (relaxed, for CI runners) | release (production thresholds)
TERMIT_CAP_GATE_TIER=release
TERMIT_CAP_MIN_REPORTS=2
TERMIT_CAP_MIN_MEAN_PASS_GAP=-0.05
TERMIT_CAP_MIN_MEAN_QUALITY_GAP=-0.10
TERMIT_CAP_MIN_WIN_RATE=0.40
TERMIT_CAP_ALLOWED_TRENDS=flat,improving
TERMIT_EVAL_CAPABILITY_BASELINE_PATH=./data/eval_capability_baseline.json
# Capability regression gate vs data/eval_capability_baseline.json
TERMIT_CAP_REG_MAX_PASS_GAP_DROP=0.05
TERMIT_CAP_REG_MAX_QUALITY_GAP_DROP=0.05
TERMIT_CAP_REG_MAX_WIN_RATE_DROP=0.10
# Quarterly review orchestration (scripts/capability_quarterly_review.sh)
TERMIT_CAP_REVIEW_LIMIT=12
TERMIT_CAP_REFRESH_BASELINE=0
# Orchestration eval-slice defaults (used by CI scripts)
TERMIT_ORCH_SPIKE_MIN_PASS_RATE=0.00
TERMIT_ORCH_SPIKE_MAX_PROMPTS=3
TERMIT_ORCH_SPIKE_TIMEOUT_SECONDS=120
# Orchestration gate tiers: ci|deep|release (CI-safe) | local (requires tool-loop steps)
TERMIT_ORCH_GATE_TIER=ci
TERMIT_ORCH_MIN_TOOL_LOOP_STEPS=1
# Local profile: ./scripts/enable_orchestration_tool_loop.sh sets tier=local + tool loop on
TERMIT_ORCH_REQUIRE_TOOL_LOOP=false
# Weekly closed loop (scripts/weekly_closed_loop.sh)
TERMIT_WEEKLY_RUN_TRAINING_LOOP=false
TERMIT_ORCH_DEEP_MIN_PASS_RATE=0.30
TERMIT_ORCH_DEEP_MIN_RETRY_SUCCESS_RATE=0.30
TERMIT_ORCH_RELEASE_MIN_PASS_RATE=0.50
TERMIT_ORCH_RELEASE_MIN_RETRY_SUCCESS_RATE=0.40
TERMIT_ORCH_GATE_MIN_TOTAL=3
TERMIT_FAST_MODEL=ollama:qwen2.5-coder
TERMIT_FRONTIER_FALLBACK_MODEL=openai_compat:deepseek-ai/DeepSeek-V3
TERMIT_ROUTING_COST_AWARE_ENABLED=false
# DPO weekly pipeline (scripts/finetune_dpo_pipeline.py)
TERMIT_DPO_REQUIRED=false
TERMIT_DPO_BOOTSTRAP_IF_EMPTY=true
TERMIT_FINETUNE_AUTO_TRAIN_DPO=false
# GPU path: scripts/dpo_gpu_train.sh (auto dry-run without nvidia-smi/torch.cuda)
TERMIT_DPO_GPU_REQUIRED=false
TERMIT_ROUTING_DEFAULT_OPENAI_COST_USD=0.002
TERMIT_ROUTING_DEFAULT_OLLAMA_COST_USD=0.0
# model-specific override format: model=usd_per_request,model=usd_per_request
TERMIT_ROUTING_MODEL_COSTS=
TERMIT_REASONING_DRAFT_MODEL=
TERMIT_REASONING_CRITIC_MODEL=
TERMIT_ORCH_OPENHANDS_CONTRACT_ENABLED=false
TERMIT_ORCH_TOOL_LOOP_EXECUTION_ENABLED=false
# Local eval gate fixture coder (ORCH11); enable via scripts/enable_orchestration_tool_loop.sh
TERMIT_ORCH_EVAL_FIXTURE_CODER=false
TERMIT_ORCH_ENABLE_EVAL_FIXTURE=true
TERMIT_ORCH_SPIKE_USE_FIXTURE=false
TERMIT_ORCH_LIVE_MODEL=ollama:qwen2.5-coder
TERMIT_ORCH_ROUTING_POLICY=default
# When live model omits tool_actions JSON, run default list_files (*.md) once
TERMIT_ORCH_TOOL_LOOP_FALLBACK=true
# strict_live gate tier: max fallback delta (0 = model must emit JSON)
TERMIT_ORCH_MAX_TOOL_LOOP_FALLBACK_DELTA=
TERMIT_ORCH_STRICT_LIVE_RETRIES=5
TERMIT_ORCH_STRICT_RESTART_ON_RETRY=true

# CI/nightly: bootstrap Ollama + tiny model for macOS live gate
TERMIT_OLLAMA_CI_BOOTSTRAP=false
TERMIT_OLLAMA_CI_MODEL=tinyllama
# macOS nightly: optional strict live gate after fallback gate
TERMIT_MACOS_ORCH_TRY_STRICT=false
TERMIT_MACOS_ORCH_STRICT_REQUIRED=false
TERMIT_MACOS_ORCH_REQUIRED=false

# Do-all plan (закрытие фазы 5: verify + train + plan status)
# TERMIT_PLAN_TRY_STRICT_LIVE=false   — strict live gate в do_all_plan (opt-in)
# TERMIT_PLAN_STATUS_STRICT=false     — exit 1 при product/finetune warnings
# TERMIT_PLAN_SKIP_LIVE_ORCH=false    — пропустить live orchestration gate
# TERMIT_DO_ALL_PLAN=false            — запустить do_all_plan.sh из do_all_automatic
# TERMIT_DO_ALL_SKIP_HOSTED=false     — пропустить hosted_smoke на :8080 (если docker up)
# TERMIT_BETA_DEV_SEED=false          — scripts/seed_beta_cohort_dev.py (local dev only)
TERMIT_DO_ALL_TRY_LIVE_ORCH=false
TERMIT_DO_ALL_TRY_STRICT_LIVE_ORCH=false
TERMIT_DO_ALL_CAPTURE_KPI_BASELINE=false
TERMIT_DO_ALL_TRY_CLOUD=false

# Cloud benchmark cycle (scripts/cloud_benchmark_cycle.sh)
TERMIT_RUN_CLOUD_BENCHMARK=true
TERMIT_CLOUD_BENCHMARK_SCENARIOS=model_bound
TERMIT_CLOUD_BENCHMARK_REQUIRED=false
TERMIT_EVAL_HUMANEVAL_SCENARIOS_PATH=./data/eval_scenarios_humaneval.json
TERMIT_EVAL_MODEL_BENCHMARK_SCENARIOS_PATH=./data/eval_scenarios_model_benchmark.json

# Platform parity: web search via self-hosted SearXNG (default, no API key)
# TERMIT_SEARCH_PROVIDER=searxng|stub|http|perplexity|auto
TERMIT_SEARCH_PROVIDER=searxng
TERMIT_SEARCH_API_URL=http://127.0.0.1:8888
TERMIT_SEARCH_API_KEY=

# Online projects: httpx (default) or playwright (pip install -r requirements-online.txt)
# Playwright also powers MCP preset termit-browser — see docs/MCP_BROWSER_RU.md
TERMIT_BROWSER_BACKEND=httpx
TERMIT_ASSIGNMENTS_DIR=./data/assignments

# Platform parity: MCP registry, hooks, skills, trace spans, schedules
TERMIT_MCP_REGISTRY_PATH=./data/mcp_servers.json
TERMIT_HOOKS_CONFIG_PATH=./data/hooks/hooks.json
TERMIT_HOOKS_WEBHOOK_URL=
TERMIT_HOOKS_ENABLED=true
TERMIT_SKILLS_DIR=./data/skills
TERMIT_TRACE_SPANS_DB_PATH=./termit_trace_spans.db
TERMIT_LOG_JSON=false
TERMIT_LOG_LEVEL=INFO
TERMIT_AGENT_SCHEDULES_ENABLED=true
TERMIT_AGENT_SCHEDULES_DB_PATH=./termit_agent_schedules.db

# Daily self-improvement loop (diagnose KPI/eval/DLQ → targeted agent runs)
TERMIT_DAILY_IMPROVEMENT_ENABLED=false
TERMIT_DAILY_IMPROVEMENT_HOUR=2
TERMIT_DAILY_IMPROVEMENT_MINUTE=0
TERMIT_DAILY_IMPROVEMENT_AGENT_ID=
TERMIT_DAILY_IMPROVEMENT_MAX_AGENT_RUNS=3
TERMIT_DAILY_IMPROVEMENT_MAX_DLQ_REPLAY=2
TERMIT_DAILY_IMPROVEMENT_MAX_EVAL_FIXES=2
TERMIT_DAILY_IMPROVEMENT_EVAL_PROBE_LIMIT=12
TERMIT_DAILY_IMPROVEMENT_RUN_EVAL_PROBE=true
TERMIT_DAILY_IMPROVEMENT_AUTO_CREATE_AGENT=true
TERMIT_DAILY_IMPROVEMENT_STATE_PATH=./data/ops/daily_improvement_state.json

# Response cache and telemetry
TERMIT_RESPONSE_CACHE_BACKEND=memory
TERMIT_RESPONSE_CACHE_SQLITE_PATH=./termit_response_cache.db
TERMIT_RESPONSE_CACHE_TTL_SECONDS=120
TERMIT_TELEMETRY_MAX_LATENCY_POINTS=5000
TERMIT_METRICS_SNAPSHOT_FILE=./data/metrics_snapshots.jsonl
