{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termit://media/brand_kit.schema.json",
  "title": "BrandKit",
  "type": "object",
  "required": ["brand_kit_id", "name", "colors"],
  "properties": {
    "brand_kit_id": { "type": "string" },
    "name": { "type": "string" },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "fonts": { "type": "array", "items": { "type": "string" } },
    "logo_paths": { "type": "array", "items": { "type": "string" } },
    "voice_id": { "type": "string", "description": "ElevenLabs voice id" },
    "music_mood": { "type": "string" },
    "style_prompt_suffix": { "type": "string" }
  },
  "additionalProperties": false
}
