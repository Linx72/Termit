# Локальные пороги для .cursor/hooks/token_watch.py
# Скопируйте в token_watch.env и отредактируйте при необходимости.
#
# Регистрация hook'ов — только глобально: ~/.cursor/hooks.json
# (run_token_watch.py → этот скрипт в Termit, иначе ~/.cursor/hooks/token_watch.py).
# Проектный hooks.json не нужен — так нет двойных срабатываний.

TERMIT_HOOK_CONTEXT_WARN_PERCENT=80
TERMIT_HOOK_CONTEXT_CRITICAL_PERCENT=92
TERMIT_HOOK_RATE_WARN_SCORE_PER_MIN=120
TERMIT_HOOK_RATE_CRITICAL_SCORE_PER_MIN=220
TERMIT_HOOK_NOTIFY_COOLDOWN_SEC=120
